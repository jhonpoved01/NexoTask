{
  "name": "proyecto-js-backend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "json-server --watch mock/db.json --port 3000",
    "dev:mock": "npm run dev",
    "server": "npm run dev",
    "dev:network": "json-server --watch mock/db.json --host 0.0.0.0 --port 3000",
    "start": "node src/server.js",
    "dev:api": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "json-server": "0.17.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2"
  }
}
