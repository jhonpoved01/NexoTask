# Entorno de ejecución: development, test o production
NODE_ENV=development

# Interfaz y puerto de la API Express
HOST=127.0.0.1
PORT=3001

# Orígenes permitidos, separados por comas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tamaño máximo aceptado para cuerpos JSON
JSON_LIMIT=100kb

# Conexión MySQL de la aplicación (utiliza un usuario técnico, nunca root)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexotask
DB_USER=nexotask_app
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10
